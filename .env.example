# Copy to .env and fill in paths / optional API key.
# Local checkpoints (download from Hugging Face after accepting the license)
OSS_RAW=./checkpoints/krea2_raw.safetensors
OSS_TURBO=./checkpoints/krea2_turbo.safetensors

# Optional: Hugging Face token for gated model downloads
# HF_TOKEN=

# Optional hosted Krea API fallback (no local GPU required)
# KREA_API_KEY=
# Alias also accepted by some Krea docs:
# KREA_API_TOKEN=

# Studio paths
CHARACTERS_DIR=./characters
OUTPUTS_DIR=./outputs
KREA2_REPO=./vendor/krea-2

# Defaults
DEFAULT_RESOLUTION=1024
DEFAULT_LORA_STRENGTH=0.85
DEFAULT_CREATIVITY=0.55
